{
  "name": "pdf-ink",
  "version": "0.2.0",
  "private": true,
  "description": "Obsidian plugin: write on PDFs with a stylus, built on EmbedPDF",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs production",
    "dev": "node scripts/build.mjs",
    "test": "node scripts/build.mjs test && node test/out/units.cjs && node test/viewer.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@embedpdf/core": "^2.15.1",
    "@embedpdf/engines": "^2.15.1",
    "@embedpdf/models": "^2.15.1",
    "@embedpdf/pdfium": "^2.15.1",
    "@embedpdf/plugin-annotation": "^2.15.1",
    "@embedpdf/plugin-capture": "^2.15.1",
    "@embedpdf/plugin-document-manager": "^2.15.1",
    "@embedpdf/plugin-export": "^2.15.1",
    "@embedpdf/plugin-history": "^2.15.1",
    "@embedpdf/plugin-interaction-manager": "^2.15.1",
    "@embedpdf/plugin-pan": "^2.15.1",
    "@embedpdf/plugin-render": "^2.15.1",
    "@embedpdf/plugin-scroll": "^2.15.1",
    "@embedpdf/plugin-selection": "^2.15.1",
    "@embedpdf/plugin-tiling": "^2.15.1",
    "@embedpdf/plugin-viewport": "^2.15.1",
    "@embedpdf/plugin-zoom": "^2.15.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  }
}
